# 대기열 서버(:4000)와 학교 서버(:3000)만 아는 비밀키 (L4 통과 토큰 서명). 실제 값은 .env 에만 두고 커밋하지 않는다
QUEUE_SECRET=dev-only-secret-change-me

# 학교 서버 시계를 일부러 어긋나게 하는 값 (L5 서버 시간 맞추기 실습). 0 이면 어긋나지 않는다
SCHOOL_CLOCK_SKEW_MS=2300

# ---- L7 AI 시간표 에이전트 -------------------------------------------------
# 쓰고 싶은 회사 하나의 키만 넣으면 된다. 키는 서버에만 있고 브라우저로 내려가지 않는다
#   Claude  https://console.anthropic.com  -> API Keys
#   OpenAI  https://platform.openai.com    -> API keys
#   Gemini  https://aistudio.google.com    -> Get API key (무료 사용량이 있다)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# 어느 회사를 쓸지: anthropic, openai, gemini, mock. 비우면 키가 들어 있는 첫 회사, 아무 키도 없으면 mock(모의 AI)
AI_PROVIDER=
# 모델 이름. 비우면 회사별 기본값 (anthropic: claude-opus-5-5, openai: gpt-6-luna, gemini: gemini-3.6-flash)
AI_MODEL=
