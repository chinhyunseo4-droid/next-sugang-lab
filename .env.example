# 대기열 서버(:4000)와 학교 서버(:3000)만 아는 비밀키 (L4 통과 토큰 서명). 실제 값은 .env 에만 두고 커밋하지 않는다
QUEUE_SECRET=dev-only-secret-change-me

# 학교 서버 시계를 일부러 어긋나게 하는 값 (L5 서버 시간 맞추기 실습). 0 이면 어긋나지 않는다
SCHOOL_CLOCK_SKEW_MS=2300

# L7 AI 시간표 에이전트. 키가 없으면 모의 AI 로 동작한다. 키는 서버에만 있고 브라우저로 내려가지 않는다
ANTHROPIC_API_KEY=
# 쓸 모델. 비우면 claude-opus-5-5. 비용을 줄이려면 claude-haiku-5-5 처럼 바꿀 수 있다
AI_MODEL=
